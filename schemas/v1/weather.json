{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "weather_id", "region_id", "location", "retrieved_at", "forecast_retrieved_at", "alerts_retrieved_at", "freshness", "current", "hourly", "extended", "alerts", "provenance", "provider_errors"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "weather_id": {"type": "string", "pattern": "^wx1:"},
    "region_id": {"type": "string", "minLength": 1},
    "location": {
      "type": "object",
      "required": ["latitude", "longitude", "timezone"],
      "properties": {
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "timezone": {"type": "string", "minLength": 1}
      }
    },
    "retrieved_at": {"type": "string", "format": "date-time"},
    "forecast_retrieved_at": {"type": "string", "format": "date-time"},
    "alerts_retrieved_at": {"type": "string", "format": "date-time"},
    "freshness": {"enum": ["fresh", "stale", "expired"]},
    "current": {
      "type": "object",
      "required": ["source_ids"],
      "properties": {"source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
    },
    "hourly": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start_time", "source_ids"],
        "properties": {
          "start_time": {"type": "string", "format": "date-time"},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "extended": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "start_time", "source_ids"],
        "properties": {
          "name": {"type": "string"},
          "start_time": {"type": "string", "format": "date-time"},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "alerts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["alert_id", "event", "source_ids"],
        "properties": {
          "alert_id": {"type": "string"},
          "event": {"type": "string"},
          "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "retrieved_at", "endpoints"],
        "properties": {
          "source_id": {"type": "string"},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "endpoints": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "provider_errors": {"type": "array", "items": {"type": "string"}}
  }
}
